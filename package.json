{
  "name": "tma-project",
  "version": "1.0.0-beta.1",
  "private": true,
  "scripts": {
    "dev": "node ./spawndock/dev.mjs",
    "agent": "node ./spawndock/agent.mjs",
    "agent:session": "node ./spawndock/session.mjs",
    "dev:next": "node ./spawndock/next.mjs",
    "dev:tunnel": "node ./spawndock/tunnel.mjs",
    "dev:https": "next dev --experimental-https",
    "build": "next build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.strict.json --noEmit",
    "publish:github-pages": "node ./spawndock/publish.mjs",
    "start": "next start",
    "lint": "eslint ."
  },
  "dependencies": {
    "@telegram-apps/sdk": "^3.11.0",
    "@telegram-apps/telegram-ui": "^2.1.13",
    "@tma.js/sdk-react": "^3.0.11",
    "@tonconnect/ui-react": "^2.3.1",
    "eruda": "^3.4.3",
    "next": "16.0.7",
    "next-intl": "^4.5.5",
    "normalize.css": "^8.0.1",
    "react": "^19",
    "react-dom": "^19",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@effect/language-service": "^0.84.1",
    "@prover-coder-ai/component-tagger": "^1.0.31",
    "@prover-coder-ai/eslint-plugin-suggest-members": "^0.0.26",
    "@spawn-dock/dev-tunnel": "1.0.9",
    "@spawn-dock/mcp": "1.0.5",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.0.4",
    "postcss": "^8",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "vitest": "4.1.2"
  }
}
